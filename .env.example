# Copy to .env and adjust. Everything here can also be changed later in the app under You.

# Set to 1 when the app is served over HTTPS (recommended) so the login cookie is HTTPS-only.
SECURE_COOKIE=0

# Download Livsmedelsverket's food database (~2,500 Swedish foods) on first start.
AUTO_IMPORT_SLV=1

# Photo recognition. Fill in one or more; the admin can also do this in the app.
AI_DEFAULT_PROVIDER=ollama
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5vl:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY is used when empty).
USDA_API_KEY=
